{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamjam1312/LOKROS-Arch-based/raw/main/schemas/update-channel.schema.json",
  "title": "LOKRO OS update channel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "repository",
    "channel",
    "architecture",
    "version",
    "releaseTag",
    "releaseApi",
    "manifestUrl",
    "repositoryArchiveAsset",
    "repositoryArchiveChecksumAsset",
    "automaticPolicy",
    "rebootRecommendedFor"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "LOKRO OS Desktop" },
    "repository": { "const": "jamjam1312/LOKROS-Arch-based" },
    "channel": { "enum": ["alpha", "beta", "stable"] },
    "architecture": { "const": "x86_64" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:alpha|beta)\\.[0-9]+)?$" },
    "releaseTag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:alpha|beta)\\.[0-9]+)?$" },
    "releaseApi": { "type": "string", "pattern": "^https://api\\.github\\.com/repos/jamjam1312/LOKROS-Arch-based/releases/tags/v" },
    "manifestUrl": { "const": "https://raw.githubusercontent.com/jamjam1312/LOKROS-Arch-based/main/LOKRO_UPDATE_CHANNEL.json" },
    "repositoryArchiveAsset": { "type": "string", "pattern": "^lokro-repo-[A-Za-z0-9._-]+\\.tar\\.zst$" },
    "repositoryArchiveChecksumAsset": { "type": "string", "pattern": "^lokro-repo-[A-Za-z0-9._-]+\\.tar\\.zst\\.sha256$" },
    "automaticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkOnBoot", "interval", "downloadOfficialPackages", "installWithoutLocalConfirmation"],
      "properties": {
        "checkOnBoot": { "const": true },
        "interval": { "const": "5h" },
        "downloadOfficialPackages": { "type": "boolean" },
        "installWithoutLocalConfirmation": { "const": false }
      }
    },
    "rebootRecommendedFor": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
