[Basic Settings]
Indexing-Enabled=true
only basic indexing=true
index hidden folders=false

[General]
dbVersion=2
exclude filters=*.tmp,*.part,*.o,*.obj,*.class,*.pyc,node_modules,.git,.cache,build,dist,target
exclude filters version=8
exclude folders[$e]=$HOME/.cache/,$HOME/.local/share/Trash/,$HOME/node_modules/,$HOME/build/,$HOME/target/
first run=false
folders[$e]=$HOME/
