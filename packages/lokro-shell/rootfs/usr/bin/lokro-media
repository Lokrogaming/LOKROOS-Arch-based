#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

command -v vlc >/dev/null 2>&1 || {
    kdialog --error 'Die VLC-Wiedergabekomponente ist nicht installiert.' --title 'LOKRO Media' 2>/dev/null || true
    exit 1
}

exec vlc --no-video-title-show --qt-name-in-title --started-from-file "$@"
