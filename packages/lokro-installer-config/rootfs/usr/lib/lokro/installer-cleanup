#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

systemctl disable lokro-live-user.service 2>/dev/null || true
rm -f /etc/systemd/system/multi-user.target.wants/lokro-live-user.service
rm -f /etc/systemd/system/lokro-live-user.service
rm -f /etc/sddm.conf.d/10-lokro-live.conf /etc/sudoers.d/10-liveuser
rm -f /usr/local/sbin/lokro-create-live-user
rm -f /usr/local/sbin/lokro-smoke-ready
rm -f /etc/xdg/autostart/lokro-smoke-ready.desktop
userdel --remove liveuser 2>/dev/null || true

if grep -q '^\[lokro-media\]' /etc/pacman.conf; then
    sed -i '/^# Removed from the installed target by Calamares\.$/,$d' /etc/pacman.conf
fi
rm -rf /opt/lokro/repo
rm -f /var/lib/pacman/sync/lokro-media.db

pacman -Rns --noconfirm calamares-lokro lokro-installer-config 2>/dev/null || true
systemctl set-default graphical.target
