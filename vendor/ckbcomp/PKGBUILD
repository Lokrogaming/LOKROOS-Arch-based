# SPDX-License-Identifier: GPL-3.0-or-later
pkgname=ckbcomp
pkgver=1.249
pkgrel=1
pkgdesc='Compile an XKB keyboard description to a console keymap'
arch=('any')
url='https://salsa.debian.org/installer-team/console-setup'
license=('GPL-2.0-or-later')
depends=('perl' 'xkeyboard-config')
source=("https://deb.debian.org/debian/pool/main/c/console-setup/console-setup_${pkgver}.tar.xz")
sha256sums=('2042e268b085ad900f2f9863715d67fadb95b8994554f10d407fc14f224b73ae')

package() {
  cd "${srcdir}/console-setup"
  install -Dm755 Keyboard/ckbcomp "${pkgdir}/usr/bin/ckbcomp"
  install -Dm644 man/ckbcomp.1 "${pkgdir}/usr/share/man/man1/ckbcomp.1"
  install -Dm644 debian/copyright "${pkgdir}/usr/share/licenses/${pkgname}/copyright"
}
